# --- Database (PostgreSQL) ---------------------------------------------
# Pooled connection string used by the running app (e.g. Neon's "-pooler" host).
DATABASE_URL="postgresql://user:password@host-pooler.example.com/dbname?sslmode=require"
# Direct (non-pooled) connection used only for running migrations.
DIRECT_URL="postgresql://user:password@host.example.com/dbname?sslmode=require"

# --- Auth (Auth.js / NextAuth v5) ---------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-strong-random-secret"
# Public URL of the deployed app. Required in production.
NEXTAUTH_URL="https://your-domain.example.com"
# Set to "true" only if this app sits behind a reverse proxy that Auth.js
# needs to trust for host/protocol detection (most non-Vercel hosts).
AUTH_TRUST_HOST="false"

# --- Non-conformity photo storage (S3-compatible: R2, S3, etc.) --------
# All five must be set in production — without them, uploads are rejected
# rather than silently written to the container's ephemeral disk.
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_BUCKET="aegis-nc-photos"
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL the uploaded photos are served from (bucket public URL,
# or a custom domain / CDN in front of the bucket).
S3_PUBLIC_URL_BASE="https://photos.your-domain.example.com"

# --- Seed script (prisma/seed.ts) and admin:reset-password --------------
# Bootstrap/reset admin account. Required — the seed has no fallback
# password. Minimum 12 characters.
ADMIN_EMAIL="admin@your-company.com"
ADMIN_NAME="Administrador"
ADMIN_PASSWORD=""
# Set to "true" only for local/demo environments — creates demo operators
# and 4 sample forklifts. Never set this in production. Requires
# DEMO_PASSWORD below (also no fallback).
SEED_DEMO_DATA="false"
DEMO_PASSWORD=""

# --- Login page ----------------------------------------------------------
# Set to "true" only for demo/staging to show the demo credentials hint on
# the login screen. Must stay unset/false in production.
SHOW_DEMO_CREDENTIALS="false"
